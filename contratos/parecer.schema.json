{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parecer auxiliar (proposta)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "submissionId",
    "feedback",
    "requiresHumanReview"
  ],
  "properties": {
    "submissionId": {
      "type": "string",
      "minLength": 1
    },
    "feedback": {
      "type": "string",
      "maxLength": 4000
    },
    "requiresHumanReview": {
      "type": "boolean"
    },
    "similaridadeIndicativa": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  }
}
